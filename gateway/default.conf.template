# SportLens edge: serves the web app and routes the APIs.
#   /api/v1/*, /api/health, /health -> core API (users, facilities, futsal)
#   /padel/api/*                    -> padel service (/api/*)
#   everything else                 -> SPA (index.html fallback)
# ${VARS} are filled by the nginx image's envsubst at start; plain $vars are nginx's own.

upstream core_api { server ${CORE_UPSTREAM}; keepalive 32; }
upstream padel_api { server ${PADEL_UPSTREAM}; keepalive 16; }

# Never log query strings: padel media tokens travel as ?token=
log_format edge escape=json '{"t":"$time_iso8601","rid":"$request_id","ip":"$remote_addr","m":"$request_method",'
                            '"uri":"$uri","s":$status,"b":$body_bytes_sent,"rt":$request_time,'
                            '"urt":"$upstream_response_time","ua":"$http_user_agent"}';

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_status 429;

map $http_x_request_id $rid { default $http_x_request_id; "" $request_id; }

server {
    listen 8080;
    server_tokens off;
    access_log /dev/stdout edge;

    client_max_body_size ${MAX_UPLOAD_SIZE};
    gzip on;
    gzip_types application/json application/javascript text/css text/csv image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: ${CSP_MEDIA_EXTRA}; media-src 'self' blob: ${CSP_MEDIA_EXTRA}; connect-src 'self' ${CSP_MEDIA_EXTRA}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $rid;
    add_header X-Request-ID $rid always;

    location = /healthz { access_log off; default_type application/json; return 200 '{"ok":true}'; }

    # --- core API -------------------------------------------------------------------------
    location /api/v1/auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://core_api;
    }
    # signed video uploads / downloads (local storage backend): stream, do not buffer to disk
    location /api/v1/storage/ {
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://core_api;
    }
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_read_timeout 120s;
        proxy_pass http://core_api;
    }
    location = /health { access_log off; proxy_pass http://core_api; }

    # --- padel ----------------------------------------------------------------------------
    location = /padel/api/health { access_log off; proxy_pass http://padel_api/api/health; }
    location /padel/api/ {
        limit_req zone=api burst=60 nodelay;
        # multipart match uploads and ranged video playback: stream both ways
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://padel_api/api/;
    }

    # --- web app --------------------------------------------------------------------------
    root /usr/share/nginx/html;
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: ${CSP_MEDIA_EXTRA}; media-src 'self' blob: ${CSP_MEDIA_EXTRA}; connect-src 'self' ${CSP_MEDIA_EXTRA}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
