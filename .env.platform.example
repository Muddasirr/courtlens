# SportLens platform settings (copy to .env.platform; never commit the copy)
PUBLIC_URL=http://localhost:8080
GATEWAY_PORT=8080
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=
PADEL_MEDIA_SECRET=
# optional service token for scripts calling the padel API directly
PADEL_API_TOKEN=
# file padel matches created before platform sign-in under this facility id
PADEL_LEGACY_FACILITY=
# GPU jobs: futsal uses ~/.kaggle (account muddasirr), padel uses this key (account hadivenix)
KAGGLE_API_KEY_LSECOND=
VISION_BACKEND=kaggle
PADEL_BACKEND=kaggle
COURT_FORMAT=5v5
CORE_API_WORKERS=2
MAX_UPLOAD_SIZE=20g
# S3-compatible storage instead of local disk
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
